# Required — the app refuses to start without it.
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-string

# Optional: override storage paths (defaults shown).
# In the Docker / Portainer deployment these are set to /data/... in the Dockerfile,
# so a single named volume at /data holds all persistent state.
# SOUNDBOARD_SOUNDS_DIR=sounds
# SOUNDBOARD_DB_FILE=sounds_db.json
# SOUNDBOARD_USERS_DB=users.db

# Optional: max accepted upload size in MB (default 25).
# SOUNDBOARD_MAX_UPLOAD_MB=25

# Optional: brute-force cap on /api/auth — this many attempts per IP within
# the window before further attempts get a 429 (defaults shown).
# SOUNDBOARD_AUTH_RATE_LIMIT=10
# SOUNDBOARD_AUTH_RATE_WINDOW=300

# --- Portainer stack environment variables ---
# When deploying via Portainer's "Stack from Git Repository", set these in the
# stack's Environment variables section (not committed here):
#   SECRET_KEY        — long random string (e.g. `openssl rand -hex 32`)
#   SOUNDBOARD_PORT   — host port to expose (defaults to 5000)
